{
  "name": "resq-backend",
  "version": "1.0.0",
  "description": "RESQ Disaster Relief — Node.js API Gateway",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build": "prisma generate && esbuild src/index.js --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.js",
    "db:check": "node src/scripts/dbCheck.js"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "prisma": "^5.22.0",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.7"
  }
}
